# Copy to .env on the Docker HOST. Never commit real credentials.
# House01 MVP: one tenant, one private storage channel, one polling bot.
ARCHIVE_IMAGE=ghcr.io/bscongluanbui/mycameratele:latest
BOT_API_IMAGE=ghcr.io/bscongluanbui/mycameratele-bot-api:latest
TENANT_ID=house01
TELEGRAM_DESTINATION=channel
# Private channel numeric ID, usually -100...; add this bot as administrator
# with permission to post. Blank/invalid/inaccessible ID blocks upload;
# no fallback post to the owner's private chat occurs.
TELEGRAM_STORAGE_CHANNEL_ID=

# Preserve compressed video/audio: MP4 container stream copy, never encode.
# Unsupported MP4 stream/container stays failed_remux/needs_review for review.
# Optional raw mode: MEDIA_MODE=raw (byte-identical source document).
MEDIA_MODE=remux_copy
# Raw-mode metadata probe is OFF; no full decode is used in either mode.
PASSTHROUGH_PROBE_METADATA=false

# Add individual camera SD credentials in the dashboard, not this file.
CAMERA_HOST=HOST
CAMERA_DEVICE_PORT=8000
CAMERA_RTSP_PORT=554
CAMERA_CHANNEL=1
CAMERA_NAME=front
DISPLAY_TIMEZONE=Asia/Ho_Chi_Minh
CAMERA_TIMEZONE=Asia/Ho_Chi_Minh
# Historical SD scan every 15 minutes; explicit Start sync bypasses the wait.
SD_SYNC_INTERVAL_SECONDS=900
SCAN_INTERVAL_SECONDS=15
# Official Linux SDK matching the Docker HOST CPU, mounted by compose.sdk.yaml.
# SDK library/CA environment is applied only inside the native child process.
HCNETSDK_HOST_DIR=./sdk

# Dashboard: http://VPS_IP:8080; first login admin/admin then change credentials.
DASHBOARD_BIND_IP=0.0.0.0
DASHBOARD_PORT=8080
DASHBOARD_COOKIE_SECURE=false
# Studio source/manifest remains read-only in the worker.
INPUT_HOST_DIR=./input

TELEGRAM_BOT_TOKEN=
# Positive account USER ID, never the negative storage channel ID.
TELEGRAM_OWNER_USER_ID=
TELEGRAM_BOT_USERNAME=
# Direct Xem button opens the dashboard's scoped streaming player (no extra bot reply).
# Set an externally reachable base URL; prefer HTTPS when a domain is available.
# Channel Xem opens the original Telegram post; viewers must join the channel.
# Keep blank to disable VPS web playback. Optional only for owner_private mode.
TELEGRAM_PLAYER_PUBLIC_URL=
# Legacy positive-owner alias only. New channel settings use the field above.
TELEGRAM_CHAT_ID=
# Positive USER IDs separated by commas; owner is allowed automatically.
# Bot sends a private reply only for a requested action, not every new clip.
TELEGRAM_ALLOWED_USER_IDS=

# Keep the currently configured API until a deliberate Local API migration.
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_API_MODE=cloud
TELEGRAM_MAX_BYTES=50000000
ENABLE_UPLOAD=false
# Successful upload + committed Telegram metadata starts retention.
# Unsent, ambiguous and failed files are retained, not discarded on this timer.
KEEP_CACHE=false
CACHE_RETENTION_HOURS=1
# CACHE_RETENTION_HOURS=0 means immediate cleanup after confirmed upload/commit.
CACHE_MAX_GB=100
CACHE_MIN_FREE_GB=5

# Optional Local Bot API requires compose.local.yaml + --profile local-api.
# It receives streamed multipart; no worker cache filesystem mount is needed.
# Switching an active bot from cloud requires controlled cloud logOut first.
# Get application credentials at https://my.telegram.org; never share them.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
BOT_API_BUILD_JOBS=2
# NEW installation optional project override; do not set this on old volumes.
# HOUSE01_PROJECT_NAME=mycameratele-house01
