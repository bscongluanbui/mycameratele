# Copy to .env on the Docker host. Keep secrets only in that local file.
# Published images: pin a version or sha256 digest when desired.
ARCHIVE_IMAGE=ghcr.io/bscongluanbui/mycameratele:latest
BOT_API_IMAGE=ghcr.io/bscongluanbui/mycameratele-bot-api:latest

# Legacy doctor --network defaults; add individual cameras in the dashboard.
# Replace HOST with your camera's LAN hostname or IPv4 address before probing.
CAMERA_HOST=HOST
CAMERA_DEVICE_PORT=8000
CAMERA_RTSP_PORT=554
CAMERA_CHANNEL=1
CAMERA_NAME=front
DISPLAY_TIMEZONE=Asia/Ho_Chi_Minh
# Change these zones to match the actual camera recording timezone.
CAMERA_TIMEZONE=Asia/Ho_Chi_Minh

# Web dashboard: generated token is persisted in /data/dashboard_token if blank.
# Retrieve on Linux: docker compose exec dashboard cat /data/dashboard_token
DASHBOARD_TOKEN=
DASHBOARD_BIND_IP=127.0.0.1
DASHBOARD_PORT=8080

# Exported MP4s and manifest.json on the Docker host. Container path is /input.
INPUT_HOST_DIR=./input

# Fixed owner's private chat is the automatic upload destination.
# Owner ID is a positive numeric USER ID, not a token.
# Obtain your own account's user ID; never auto-claim the first person messaging.
# Open the bot in Telegram and send /start before allowing uploads.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_USER_ID=
# Optional username without @. If blank, /start can resolve it with getMe.
TELEGRAM_BOT_USERNAME=
# Legacy alias only: positive ID of the SAME owner, never a channel/group ID.
# Leave blank when TELEGRAM_OWNER_USER_ID is set.
TELEGRAM_CHAT_ID=
# Owner is always allowed automatically. Additional positive viewer IDs use commas.
# Example structure: OWNER_ID,VIEWER_ID_2,VIEWER_ID_3 (replace with real integers).
# Every allowed viewer opens /start and receives requested replays in THEIR chat.
# Viewers do not receive automatic uploads or enable the owner's upload gate.
TELEGRAM_ALLOWED_USER_IDS=
# Cloud test defaults: retain cache and do not upload until deliberately enabled.
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_API_MODE=cloud
TELEGRAM_MAX_BYTES=50000000
ENABLE_UPLOAD=false
KEEP_CACHE=true
CACHE_RETENTION_HOURS=24
SCAN_INTERVAL_SECONDS=15
CACHE_MAX_GB=100
CACHE_MIN_FREE_GB=5

# Production Local Bot API: use compose.yaml + compose.local.yaml and local-api.
# The override selects local endpoint, 2000 MB, KEEP_CACHE=false and 24h retention.
# ENABLE_UPLOAD stays false unless YOU set it true, after owner /start succeeds.
# Obtain these application credentials from https://my.telegram.org.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
BOT_API_BUILD_JOBS=2
