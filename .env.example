# Copy to .env on the Docker host. Keep secrets only in that local file.
# Published images: pin a version or sha256 digest when desired.
ARCHIVE_IMAGE=ghcr.io/bscongluanbui/mycameratele:latest
BOT_API_IMAGE=ghcr.io/bscongluanbui/mycameratele-bot-api:latest

# Legacy doctor --network defaults; add individual cameras in the dashboard.
# Replace HOST with your camera's LAN hostname or IPv4 address before probing.
CAMERA_HOST=HOST
CAMERA_DEVICE_PORT=8000
CAMERA_RTSP_PORT=554
CAMERA_CHANNEL=1
CAMERA_NAME=front
DISPLAY_TIMEZONE=Asia/Ho_Chi_Minh
# Change these zones to match the actual camera recording timezone.
CAMERA_TIMEZONE=Asia/Ho_Chi_Minh

# Web dashboard: generated token is persisted in /data/dashboard_token if blank.
# Retrieve on Linux: docker compose exec dashboard cat /data/dashboard_token
DASHBOARD_TOKEN=
DASHBOARD_BIND_IP=127.0.0.1
DASHBOARD_PORT=8080

# Exported MP4s and manifest.json on the Docker host. Container path is /input.
INPUT_HOST_DIR=./input

# Telegram default: cloud API, uploads disabled until deliberately configured.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_API_MODE=cloud
TELEGRAM_MAX_BYTES=50000000
ENABLE_UPLOAD=false
KEEP_CACHE=true
SCAN_INTERVAL_SECONDS=15
CACHE_MAX_GB=100
CACHE_MIN_FREE_GB=5

# Optional local Bot API (only with --profile local-api).
# Obtain these application credentials from https://my.telegram.org.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
BOT_API_BUILD_JOBS=2
